<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.dao.BoardMapper">

    <resultMap id="BoardMap" type="com.example.demo.model.Board">
        <id     property="b_no"      column="b_no"/>
        <result property="b_email"   column="b_email"/>
        <result property="b_title"   column="b_title"/>
        <result property="b_content" column="b_content"/>
        <result property="b_date"    column="b_date"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.demo.model.Board">
        INSERT INTO board (b_email, b_title, b_content, b_date)
        VALUES (#{b_email}, #{b_title}, #{b_content}, #{b_date})
    </insert>

    <select id="getAllByNo" parameterType="string" resultType="map">
        SELECT * FROM board b
        LEFT JOIN boardComment bc m ON b.b_no = bc.b_no
        WHERE b_no = #{value}
        ORDER BY b_date DESC
    </select>
    <!-- join X -->
    <select id="getByNo" parameterType="string" resultMap="BoardMap">
        SELECT * FROM board
        WHERE b_no = #{value}
        ORDER BY b_date DESC
    </select>

    <select id="getAllBoard" resultType="map">
        SELECT * FROM board b
        LEFT JOIN boardComment bc m ON b.b_no = bc.b_no
        ORDER BY b_date DESC
    </select>

    <!-- join X -->
    <select id="getBoard" resultMap="BoardMap">
        SELECT * FROM board
        ORDER BY b_date DESC
    </select>

    <update id="update">
        UPDATE board
        <set>
            <if test="b_email != null">
                b_email = #{b_email},
            </if>
            <if test="b_title != null">
                b_title = #{b_title},
            </if>
            <if test="b_content != null">
                b_content = #{b_content},
            </if>
            <if test="b_date != null">
                b_date = #{b_date},
            </if>
        </set>
        WHERE b_no = #{b_no}
    </update>

    <delete id="deleteByNo" parameterType="string">
        DELETE FROM board WHERE b_no = #{value}
    </delete>
</mapper>
