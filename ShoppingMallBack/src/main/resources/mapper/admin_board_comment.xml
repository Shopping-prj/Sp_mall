<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.dao.admin.AdminBoardCommentMapper">

    <resultMap id="AdminBoardCommentMap" type="com.example.demo.model.admin.AdminBoardComment">
        <id     property="bc_no"      column="bc_no"/>
        <result property="bc_email"   column="bc_email"/>
        <result property="b_no"       column="b_no"/>
        <result property="bc_comment" column="bc_comment"/>
        <result property="bc_date"    column="bc_date"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.demo.model.admin.AdminBoardComment"
            useGeneratedKeys="true" keyProperty="bc_no" keyColumn="bc_no">
        INSERT INTO boardComment (bc_email, b_no, bc_comment, bc_date)
        VALUES (#{bc_email}, #{b_no}, #{bc_comment}, NOW())
    </insert>

    <update id="update" parameterType="com.example.demo.model.admin.AdminBoardComment">
        UPDATE boardComment
        SET bc_email   = #{bc_email},
        bc_comment = #{bc_comment}
        WHERE bc_no = #{bc_no}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM boardComment WHERE bc_no = #{bc_no}
    </delete>

    <select id="findById" parameterType="long" resultMap="AdminBoardCommentMap">
        SELECT * FROM boardComment WHERE bc_no = #{bc_no}
    </select>

    <select id="findByBoard" parameterType="long" resultMap="AdminBoardCommentMap">
        SELECT * FROM boardComment WHERE b_no = #{b_no} ORDER BY bc_no ASC
    </select>

    <select id="findAll" resultMap="AdminBoardCommentMap">
        SELECT * FROM boardComment ORDER BY bc_no DESC
    </select>

</mapper>