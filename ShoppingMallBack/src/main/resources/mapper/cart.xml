<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.dao.CartMapper">

    <resultMap id="CartMap" type="com.example.demo.model.Cart">
        <id     property="c_no"        column="c_no"/>
        <result property="c_email"     column="c_email"/>
        <result property="c_productId" column="c_productId"/>
        <result property="c_count"     column="c_count"/>
        <result property="c_payment"   column="c_payment"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.demo.model.Cart" useGeneratedKeys="true" keyProperty="c_no">
        INSERT INTO cart (
        c_email, c_productId, c_count, c_payment
        ) VALUES (
        #{c_email}, #{c_productId}, #{c_count}, #{c_payment}
        )
    </insert>

    <select id="getByNo" parameterType="long" resultMap="CartMap">
        SELECT * FROM cart WHERE c_no = #{value}
    </select>

    <select id="getByEmail" parameterType="string" resultMap="CartMap">
        SELECT * FROM cart WHERE c_email = #{value}
        ORDER BY c_no DESC
    </select>

    <select id="getAllCart" resultMap="CartMap">
        SELECT * FROM cart ORDER BY c_no DESC
    </select>

    <update id="updateCount">
        UPDATE cart
        SET c_count = #{c_count}
        WHERE c_no = #{c_no}
    </update>

    <delete id="deleteByNo" parameterType="long">
        DELETE FROM cart WHERE c_no = #{value}
    </delete>

    <delete id="deleteByEmail" parameterType="string">
        DELETE FROM cart WHERE c_email = #{value}
    </delete>
</mapper>
