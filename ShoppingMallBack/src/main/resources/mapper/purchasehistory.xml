<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.dao.PurchaseHistoryMapper">

    <resultMap id="PurchaseHistoryMap" type="com.example.demo.model.PurchaseHistory">
        <id     property="ph_no"       column="ph_no"/>
        <result property="ph_imp_uid"  column="ph_imp_uid"/>
        <result property="ph_email"    column="ph_email"/>
        <result property="ph_count"    column="ph_count"/>
        <result property="ph_date"     column="ph_date"/>
        <result property="ph_delivery" column="ph_delivery"/>
        <result property="ph_Refund_or_exchange"  column="ph_Refund_or_exchange"/>
        <result property="ph_address"  column="ph_address"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.demo.model.PurchaseHistory" useGeneratedKeys="true" keyProperty="ph_no">
        INSERT INTO purchaseHistory (ph_imp_uid, ph_email, ph_count, ph_date, ph_delivery, ph_payment)
        VALUES (#{ph_imp_uid}, #{ph_email}, #{ph_count}, #{ph_date}, #{ph_delivery}, #{ph_payment})
    </insert>

    <select id="getByNo" parameterType="long" resultMap="PurchaseHistoryMap">
        SELECT * FROM purchaseHistory
        WHERE ph_no = #{value}
        ORDER BY ph_date DESC
    </select>

    <select id="getAllPurchaseHistory" resultMap="PurchaseHistoryMap">
        SELECT * FROM purchaseHistory
        ORDER BY ph_date DESC
    </select>

    <select id="getByEmail" parameterType="string" resultMap="PurchaseHistoryMap">
        SELECT * FROM purchaseHistory
        WHERE ph_email = #{value}
        ORDER BY ph_date DESC
    </select>

    <update id="update">
        UPDATE purchaseHistory
        <set>
            <if test="ph_imp_uid != null">
                ph_imp_uid = #{ph_imp_uid},
            </if>
            <if test="ph_email != null">
                ph_email = #{ph_email},
            </if>
            <if test="ph_productId != null">
                ph_productId = #{ph_productId},
            </if>
            <if test="ph_count != null">
                ph_count = #{ph_count},
            </if>
            <if test="ph_date != null">
                ph_date = #{ph_date},
            </if>
            <if test="ph_delivery != null">
                ph_delivery = #{ph_delivery},
            </if>
            <if test="ph_payment != null">
                ph_Refund_or_exchange = #{ph_Refund_or_exchange},
            </if>
            <if test="ph_address != null">
                ph_address = #{ph_address},
            </if>
        </set>
        WHERE ph_no = #{ph_no}
    </update>

    <delete id="deleteByNo" parameterType="long">
        DELETE FROM purchaseHistory
        WHERE ph_no = #{value}
    </delete>

</mapper>
