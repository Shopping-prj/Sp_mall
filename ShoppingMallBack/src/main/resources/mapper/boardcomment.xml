<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.dao.BoardCommentMapper">

    <resultMap id="BoardCommentMap" type="com.example.demo.model.BoardComment">
        <id     property="bc_no"      column="bc_no"/>
        <result property="b_no"       column="b_no"/>
        <result property="bc_email"   column="bc_email"/>
        <result property="bc_comment" column="bc_comment"/>
        <result property="bc_date"    column="bc_date"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.demo.model.BoardComment">
        INSERT INTO boardComment (bc_no, b_no, bc_email, bc_comment, bc_date)
        VALUES (#{bc_no}, #{b_no}, #{bc_email}, #{bc_comment}, #{bc_date})
    </insert>

    <select id="getByNo" parameterType="string" resultMap="BoardCommentMap">
        SELECT * FROM boardComment WHERE bc_no = #{value}
    </select>

    <select id="getByBoardNo" parameterType="string" resultMap="BoardCommentMap">
        SELECT * FROM boardComment WHERE b_no = #{value} ORDER BY bc_date ASC
    </select>

    <delete id="deleteByNo" parameterType="string">
        DELETE FROM boardComment WHERE bc_no = #{value}
    </delete>
</mapper>
